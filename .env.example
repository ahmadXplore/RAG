# ==============================================================================
# ENVIRONMENT & GENERAL
# ==============================================================================
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ==============================================================================
# BACKEND API SERVER
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# SQLite default for local development:
DATABASE_URL=sqlite+aiosqlite:///d:/RAG/enterprise_rag_dev.db
DATABASE_URL_SYNC=sqlite:///d:/RAG/enterprise_rag_dev.db
# PostgreSQL production/docker (uncomment if using PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
# DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_rag

# ==============================================================================
# REDIS CACHE & RATE LIMITING
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# QDRANT VECTOR DATABASE
# ==============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==============================================================================
# AUTHENTICATION & SECRETS
# ==============================================================================
# Replace with a cryptographically secure random secret (min 32 characters)
JWT_SECRET=CHANGE_ME_USE_SECRETS_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# LLM PROVIDERS & API KEYS
# ==============================================================================
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1024
GROQ_API_KEY=CHANGE_ME_USE_SECRETS_MANAGER
OPENROUTER_API_KEY=CHANGE_ME_USE_SECRETS_MANAGER
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# LLM SAFETY & RESOURCE GUARDS (Rule 15 & Security Controls)
# ==============================================================================
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_RATE_LIMIT_PER_MINUTE=10
AGENT_MAX_RETRIEVAL_ATTEMPTS=3
AGENT_MAX_TOOL_CALLS=10
SSE_MAX_CONCURRENT_STREAMS_PER_USER=3

# ==============================================================================
# EMBEDDINGS & RERANKER
# ==============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ==============================================================================
# OBSERVABILITY & TRACING (Optional)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
