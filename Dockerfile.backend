# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

# System deps needed to compile some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency spec and install into a prefix
COPY pyproject.toml .
RUN pip install --upgrade pip setuptools wheel
RUN pip install --prefix=/install \
    "fastapi>=0.111.0" \
    "uvicorn[standard]>=0.30.0" \
    "sqlalchemy>=2.0.30" \
    "alembic>=1.13.1" \
    "pydantic>=2.7.4" \
    "pydantic-settings>=2.3.4" \
    "asyncpg>=0.29.0" \
    "psycopg[binary]>=3.1.19" \
    "aiosqlite>=0.20.0" \
    "bcrypt>=4.1.3" \
    "pyjwt[crypto]>=2.8.0" \
    "email-validator>=2.1.0" \
    "qdrant-client>=1.12.0" \
    "fastembed>=0.4.0" \
    "groq>=0.11.0" \
    "httpx>=0.27.0" \
    "langgraph>=0.2.0" \
    "tiktoken>=0.7.0" \
    "redis>=5.0.0" \
    "python-multipart>=0.0.9" \
    "PyMuPDF>=1.24.0" \
    "python-docx>=1.1.0" \
    "openpyxl>=3.1.0" \
    "pandas>=2.2.0"

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY backend/ ./backend/
COPY pyproject.toml .

# Pre-download FastEmbed ONNX models at build time so cold starts are fast
RUN python -c "\
from pathlib import Path; \
import sys; sys.path.insert(0, 'backend'); \
try: \
    from fastembed import TextEmbedding, SparseTextEmbedding; \
    TextEmbedding('BAAI/bge-small-en-v1.5'); \
    SparseTextEmbedding('Qdrant/bm25'); \
    print('Models cached'); \
except Exception as e: \
    print(f'Model pre-cache skipped: {e}') \
" || true

# Non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

# Run migrations then start server
CMD ["sh", "-c", "python -m alembic -c backend/infra/migrations/alembic.ini upgrade head && python -m uvicorn apps.api.app.main:app --host 0.0.0.0 --port 8000 --app-dir backend --workers 1"]
